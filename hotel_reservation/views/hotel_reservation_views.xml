<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_reservation_list" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-success="state == 'checked_in'"
                  decoration-muted="state in ('cancelled', 'checked_out')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="hotel_id"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="nights"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"
                            confirm="Cancel this reservation?"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="hotel_id" readonly="state != 'draft'"/>
                            <field name="adults" readonly="state != 'draft'"/>
                            <field name="children" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="checkin_date" readonly="state != 'draft'"/>
                            <field name="checkout_date" readonly="state != 'draft'"/>
                            <field name="nights"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="available_room_ids" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="room_id"
                                           domain="[('id', 'in', parent.available_room_ids)]"/>
                                    <field name="room_type_id"/>
                                    <field name="max_guests"/>
                                    <field name="price_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="checkin_date"
                      date_stop="checkout_date" color="hotel_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="hotel_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="checked_in" string="Checked In" domain="[('state', '=', 'checked_in')]"/>
                <separator/>
                <filter name="arrivals_today" string="Arrivals Today"
                        domain="[('checkin_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="departures_today" string="Departures Today"
                        domain="[('checkout_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_checkin" string="Check-in Month"
                            context="{'group_by': 'checkin_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>