<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room type -->
    <record id="view_hotel_room_type_list" model="ir.ui.view">
        <field name="name">hotel.room.type.list</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="max_adults"/>
                <field name="max_children"/>
                <field name="base_price"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Deluxe Double"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="base_price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="max_adults"/>
                            <field name="max_children"/>
                            <field name="max_guests"/>
                        </group>
                    </group>
                    <field name="amenity_ids" widget="many2many_tags"/>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Room -->
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'"
                  decoration-danger="state in ('maintenance', 'out_of_service')"
                  decoration-warning="state == 'cleaning'"
                  decoration-info="state == 'occupied'">
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="floor_id"/>
                <field name="room_type_id"/>
                <field name="max_guests"/>
                <field name="price"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_available" type="object" string="Set Available"
                            invisible="state == 'available'"/>
                    <button name="action_set_maintenance" type="object" string="Maintenance"
                            invisible="state in ('maintenance', 'occupied')"/>
                    <button name="action_set_out_of_service" type="object" string="Out of Service"
                            invisible="state in ('out_of_service', 'occupied')"
                            groups="hotel_core.group_hotel_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,occupied,cleaning,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="101"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hotel_id"/>
                            <field name="floor_id"/>
                            <field name="building_id"/>
                        </group>
                        <group>
                            <field name="room_type_id"/>
                            <field name="max_guests"/>
                            <field name="price_override"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="amenity_ids" widget="many2many_tags"/>
                    <field name="notes" placeholder="Internal notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="room_type_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="occupied" string="Occupied" domain="[('state', '=', 'occupied')]"/>
                <filter name="cleaning" string="Cleaning" domain="[('state', '=', 'cleaning')]"/>
                <group>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter name="group_type" string="Room Type" context="{'group_by': 'room_type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_hotel_hotel" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="res_model">hotel.hotel</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hotel_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">hotel.building</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hotel_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">hotel.floor</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_hotel_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">hotel.amenity</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_hotel': 1}</field>
    </record>
</odoo>