<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Roles -->
    <record id="view_hotel_staff_role_list" model="ir.ui.view">
        <field name="name">hotel.staff.role.list</field>
        <field name="model">hotel.staff.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="department"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Shifts -->
    <record id="view_hotel_shift_list" model="ir.ui.view">
        <field name="name">hotel.shift.list</field>
        <field name="model">hotel.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_hotel_staff_role" model="ir.actions.act_window">
        <field name="name">Staff Roles</field>
        <field name="res_model">hotel.staff.role</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_hotel_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">hotel.shift</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_hotel_staff" model="ir.actions.act_window">
        <field name="name">Hotel Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('hotel_id', '!=', False)]</field>
    </record>
</odoo>