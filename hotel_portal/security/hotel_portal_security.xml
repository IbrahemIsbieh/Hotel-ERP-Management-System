<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hotel_reservation_portal" model="ir.rule">
        <field name="name">Reservation: portal users see their own</field>
        <field name="model_id" ref="hotel_reservation.model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hotel_service_request_portal" model="ir.rule">
        <field name="name">Service request: portal users see their own</field>
        <field name="model_id" ref="model_hotel_service_request"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>