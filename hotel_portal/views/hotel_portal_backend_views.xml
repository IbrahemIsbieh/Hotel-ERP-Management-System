<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel settings -->
    <record id="view_hotel_hotel_form_portal" model="ir.ui.view">
        <field name="name">hotel.hotel.form.portal</field>
        <field name="model">hotel.hotel</field>
        <field name="inherit_id" ref="hotel_core.view_hotel_hotel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Online Booking" groups="hotel_core.group_hotel_manager">
                    <group>
                        <field name="portal_bookable"/>
                        <field name="portal_auto_confirm" invisible="not portal_bookable"/>
                        <field name="portal_cancel_days" invisible="not portal_bookable"/>
                        <field name="portal_max_nights" invisible="not portal_bookable"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Room type -->
    <record id="view_hotel_room_type_form_portal" model="ir.ui.view">
        <field name="name">hotel.room.type.form.portal</field>
        <field name="model">hotel.room.type</field>
        <field name="inherit_id" ref="hotel_core.view_hotel_room_type_form"/>
        <field name="arch" type="xml">
            <field name="base_price" position="after">
                <field name="portal_visible"/>
            </field>
        </field>
    </record>

    <!-- Reservation -->
    <record id="view_hotel_reservation_form_portal" model="ir.ui.view">
        <field name="name">hotel.reservation.form.portal</field>
        <field name="model">hotel.reservation</field>
        <field name="inherit_id" ref="hotel_reservation.view_hotel_reservation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_service_requests" type="object"
                        class="oe_stat_button" icon="fa-bell-o"
                        invisible="service_request_count == 0">
                    <field name="service_request_count" widget="statinfo" string="Requests"/>
                </button>
            </xpath>
            <field name="nights" position="after">
                <field name="portal_booking" invisible="not portal_booking"/>
            </field>
        </field>
    </record>

    <!-- Service requests -->
    <record id="view_hotel_service_request_list" model="ir.ui.view">
        <field name="name">hotel.service.request.list</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'new'" decoration-muted="state in ('done', 'rejected')">
                <field name="name"/>
                <field name="create_date"/>
                <field name="reservation_id"/>
                <field name="partner_id"/>
                <field name="hotel_id"/>
                <field name="request_type"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_service_request_form" model="ir.ui.view">
        <field name="name">hotel.service.request.form</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('new', 'in_progress')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="partner_id"/>
                            <field name="hotel_id"/>
                        </group>
                        <group>
                            <field name="request_type"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <group string="Request">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Response to the guest">
                        <field name="response" nolabel="1"
                               placeholder="This text is emailed to the guest when you close the request..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_service_request_search" model="ir.ui.view">
        <field name="name">hotel.service.request.search</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="partner_id"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('new', 'in_progress'))]"/>
                <filter name="mine" string="Assigned to Me"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'request_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_service_request" model="ir.actions.act_window">
        <field name="name">Guest Requests</field>
        <field name="res_model">hotel.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_hotel_online_pending" model="ir.actions.act_window">
        <field name="name">Online Bookings to Confirm</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('portal_booking', '=', True), ('state', '=', 'draft')]</field>
    </record>

    <menuitem id="menu_hotel_service_request" name="Guest Requests"
              parent="hotel_frontdesk.menu_hotel_frontdesk_root"
              action="action_hotel_service_request" sequence="40"/>
    <menuitem id="menu_hotel_online_pending" name="Online Bookings to Confirm"
              parent="hotel_frontdesk.menu_hotel_frontdesk_root"
              action="action_hotel_online_pending" sequence="5"/>
</odoo>