<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_housekeeper" model="res.groups">
        <field name="name">Hotel / Housekeeper</field>
    </record>

    <record id="group_housekeeping_supervisor" model="res.groups">
        <field name="name">Hotel / Housekeeping Supervisor</field>
        <field name="implied_ids" eval="[
            (4, ref('group_housekeeper')),
            (4, ref('hotel_core.group_hotel_user'))]"/>
    </record>

    <!-- Hotel Manager automatically becomes housekeeping supervisor -->
    <record id="hotel_core.group_hotel_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_housekeeping_supervisor'))]"/>
    </record>

    <record id="rule_hk_task_housekeeper" model="ir.rule">
        <field name="name">Housekeeper: own or unassigned tasks</field>
        <field name="model_id" ref="model_hotel_housekeeping_task"/>
        <field name="groups" eval="[(4, ref('group_housekeeper'))]"/>
        <field name="domain_force">['|', ('assigned_user_id', '=', False), ('assigned_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_hk_task_supervisor" model="ir.rule">
        <field name="name">Supervisor: all tasks</field>
        <field name="model_id" ref="model_hotel_housekeeping_task"/>
        <field name="groups" eval="[(4, ref('group_housekeeping_supervisor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>