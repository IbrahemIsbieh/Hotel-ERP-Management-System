<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hk_task_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.list</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '1' and state in ('pending', 'in_progress')"
                  decoration-muted="state in ('inspected', 'cancelled')">
                <field name="name"/>
                <field name="room_id"/>
                <field name="hotel_id"/>
                <field name="floor_id" optional="show"/>
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
                <field name="scheduled_date"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hk_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_inspect" type="object" string="Inspect &amp; Release Room"
                            class="btn-primary" invisible="state != 'done'"
                            groups="hotel_housekeeping.group_housekeeping_supervisor"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('pending', 'in_progress')"
                            groups="hotel_housekeeping.group_housekeeping_supervisor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,done,inspected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id" readonly="state != 'pending'"/>
                            <field name="hotel_id"/>
                            <field name="floor_id"/>
                            <field name="room_type_id"/>
                        </group>
                        <group>
                            <field name="task_type" readonly="state != 'pending'"/>
                            <field name="priority" widget="priority"/>
                            <field name="scheduled_date"/>
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids" readonly="state not in ('pending', 'in_progress')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timing &amp; Inspection">
                            <group>
                                <group>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration"/>
                                </group>
                                <group>
                                    <field name="inspected_by_id"/>
                                    <field name="inspected_on"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Damages, missing items, lost &amp; found..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hk_task_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.kanban</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" group_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="room_id" class="fw-bold fs-5"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="text-muted">
                            <field name="task_type"/> - <field name="hotel_id"/>
                        </div>
                        <field name="progress" widget="progressbar"/>
                        <footer class="pt-2">
                            <field name="scheduled_date"/>
                            <field name="assigned_user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hk_task_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_tasks" string="My Tasks"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned"
                        domain="[('assigned_user_id', '=', False)]"/>
                <separator/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('pending', 'in_progress'))]"/>
                <filter name="to_inspect" string="To Inspect"
                        domain="[('state', '=', 'done')]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter name="group_floor" string="Floor" context="{'group_by': 'floor_id'}"/>
                    <filter name="group_user" string="Assigned To"
                            context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hk_task" model="ir.actions.act_window">
        <field name="name">Housekeeping Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_hk_item" model="ir.actions.act_window">
        <field name="name">Checklist Template</field>
        <field name="res_model">hotel.housekeeping.item</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_hk_item_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.item.list</field>
        <field name="model">hotel.housekeeping.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>