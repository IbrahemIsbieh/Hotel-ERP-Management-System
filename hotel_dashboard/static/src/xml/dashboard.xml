<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hotel_dashboard.Dashboard">
        <div class="o_hotel_dashboard bg-view h-100 overflow-auto p-3">

            <!-- Filters -->
            <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
                <div>
                    <label class="form-label small mb-0">Hotel</label>
                    <select class="form-select form-select-sm" t-on-change="onHotelChange">
                        <option value="">All hotels</option>
                        <t t-foreach="state.hotels" t-as="hotel" t-key="hotel.id">
                            <option t-att-value="hotel.id"
                                    t-att-selected="state.hotelId === hotel.id">
                                <t t-out="hotel.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-0">From</label>
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                </div>
                <div>
                    <label class="form-label small mb-0">To</label>
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" t-on-click="() => this.setPreset('month')">This month</button>
                    <button class="btn btn-outline-secondary" t-on-click="() => this.setPreset('30d')">Last 30 days</button>
                    <button class="btn btn-outline-secondary" t-on-click="() => this.setPreset('year')">This year</button>
                </div>
                <button class="btn btn-sm btn-outline-primary ms-auto" t-on-click="openOccupancyAnalysis">
                    <i class="fa fa-table me-1"/>Occupancy analysis
                </button>
            </div>

            <div t-if="state.loading and !state.data" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin me-2"/>Loading...
            </div>

            <t t-if="state.data">
                <div t-attf-class="#{state.loading ? 'opacity-50' : ''}">

                    <!-- KPI cards -->
                    <div class="row g-3 mb-3">
                        <div t-foreach="kpis" t-as="kpi" t-key="kpi.key" class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body py-3">
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span t-out="kpi.label"/>
                                        <i t-attf-class="fa #{kpi.icon} #{kpi.cls}"/>
                                    </div>
                                    <div t-attf-class="fs-3 fw-bold #{kpi.cls}" t-out="kpi.value"/>
                                    <div class="small text-muted" t-out="kpi.sub"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Today -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-header fw-bold">
                            Today <span class="text-muted fw-normal" t-out="state.data.today.date"/>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 text-center">
                                <div t-foreach="todayItems" t-as="item" t-key="item.key" class="col-6 col-md-4 col-xl-2">
                                    <button class="btn btn-light w-100 border" t-on-click="() => this.openToday(item.key)">
                                        <i t-attf-class="fa #{item.icon} text-muted"/>
                                        <div class="fs-3 fw-bold" t-out="item.value"/>
                                        <div class="small text-muted" t-out="item.label"/>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <span class="text-muted small me-1">Room status:</span>
                                <span t-foreach="state.data.room_status" t-as="rs" t-key="rs.state"
                                      class="badge text-bg-light border">
                                    <t t-out="rs.label"/>: <t t-out="rs.count"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Daily occupancy -->
                        <div class="col-12 col-xl-8">
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">Daily occupancy (%)</div>
                                <div class="card-body">
                                    <div class="hd-bars">
                                        <div t-foreach="dailyBars" t-as="bar" t-key="bar.date"
                                             class="hd-bar" t-att-title="bar.title"
                                             t-attf-style="height: #{bar.height}%"/>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted mt-1">
                                        <span t-out="state.data.period.from"/>
                                        <span><t t-out="state.data.rooms"/> rooms - <t t-out="state.data.period.days"/> days</span>
                                        <span t-out="state.data.period.to"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reservations -->
                        <div class="col-12 col-xl-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">Reservations (by arrival date)</div>
                                <div class="card-body">
                                    <div t-foreach="state.data.reservations_by_state" t-as="rs" t-key="rs.state"
                                         class="d-flex justify-content-between border-bottom py-1">
                                        <span t-out="rs.label"/>
                                        <span class="fw-bold" t-out="rs.count"/>
                                    </div>
                                    <div class="mt-3 small text-muted">Booking channel (excluding cancelled)</div>
                                    <div class="d-flex justify-content-between">
                                        <span><i class="fa fa-globe me-1"/>Online</span>
                                        <span class="fw-bold" t-out="state.data.channels.online"/>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span><i class="fa fa-phone me-1"/>Staff / front desk</span>
                                        <span class="fw-bold" t-out="state.data.channels.staff"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Revenue by source -->
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">Revenue by source</div>
                                <div class="card-body">
                                    <div t-foreach="sourceBars" t-as="b" t-key="b.label" class="mb-3">
                                        <div class="d-flex justify-content-between small">
                                            <span t-out="b.label"/><span t-out="money(b.value)"/>
                                        </div>
                                        <div class="hd-hbar" t-attf-style="width: #{b.width}%"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Top room types -->
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">Top room types (room revenue)</div>
                                <div class="card-body">
                                    <p t-if="!roomTypeBars.length" class="text-muted small">No data for this period.</p>
                                    <div t-foreach="roomTypeBars" t-as="b" t-key="b.label" class="mb-3">
                                        <div class="d-flex justify-content-between small">
                                            <span><t t-out="b.label"/> <span class="text-muted">(<t t-out="b.extra"/>)</span></span>
                                            <span t-out="money(b.value)"/>
                                        </div>
                                        <div class="hd-hbar hd-info" t-attf-style="width: #{b.width}%"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Expenses -->
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">Expenses by category</div>
                                <div class="card-body">
                                    <p t-if="!expenseBars.length" class="text-muted small">No expenses in this period.</p>
                                    <div t-foreach="expenseBars" t-as="b" t-key="b.label" class="mb-3">
                                        <div class="d-flex justify-content-between small">
                                            <span t-out="b.label"/><span t-out="money(b.value)"/>
                                        </div>
                                        <div class="hd-hbar neg" t-attf-style="width: #{b.width}%"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        Occupancy, ADR and RevPAR are based on booked nights (confirmed, checked-in
                        and checked-out). Revenue, expenses and profit come from checked-out stays,
                        paid restaurant orders and approved expenses.
                    </p>
                </div>
            </t>
        </div>
    </t>
</templates>