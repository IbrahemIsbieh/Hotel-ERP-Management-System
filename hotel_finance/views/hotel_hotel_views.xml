<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_hotel_form_finance" model="ir.ui.view">
        <field name="name">hotel.hotel.form.finance</field>
        <field name="model">hotel.hotel</field>
        <field name="inherit_id" ref="hotel_core.view_hotel_hotel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Finance" groups="hotel_finance.group_hotel_accountant">
                    <group>
                        <group string="Taxes">
                            <field name="stay_tax_ids" widget="many2many_tags"/>
                            <field name="service_tax_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Accounting">
                            <field name="payment_journal_id"/>
                            <field name="auto_post_invoice"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>