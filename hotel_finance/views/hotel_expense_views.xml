<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_expense_list" model="ir.ui.view">
        <field name="name">hotel.expense.list</field>
        <field name="model">hotel.expense</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'">
                <field name="date"/>
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="category"/>
                <field name="partner_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_expense_form" model="ir.ui.view">
        <field name="name">hotel.expense.form</field>
        <field name="model">hotel.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pay" type="object" string="Mark as Paid"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'approved')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. A/C repair, floor 3"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hotel_id" readonly="state != 'draft'"/>
                            <field name="category" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_expense_search" model="ir.ui.view">
        <field name="name">hotel.expense.search</field>
        <field name="model">hotel.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="partner_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'draft')]"/>
                <filter name="unpaid" string="Approved, Unpaid"
                        domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">hotel.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>