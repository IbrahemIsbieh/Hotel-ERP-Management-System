<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_profit_report_pivot" model="ir.ui.view">
        <field name="name">hotel.profit.report.pivot</field>
        <field name="model">hotel.profit.report</field>
        <field name="arch" type="xml">
            <pivot string="Profitability">
                <field name="hotel_id" type="row"/>
                <field name="line_type" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="signed_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hotel_profit_report_graph" model="ir.ui.view">
        <field name="name">hotel.profit.report.graph</field>
        <field name="model">hotel.profit.report</field>
        <field name="arch" type="xml">
            <graph string="Revenue vs Expenses" type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="line_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hotel_profit_report_list" model="ir.ui.view">
        <field name="name">hotel.profit.report.list</field>
        <field name="model">hotel.profit.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="hotel_id"/>
                <field name="line_type"/>
                <field name="category"/>
                <field name="amount" sum="Total"/>
                <field name="signed_amount" sum="Net"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_profit_report_search" model="ir.ui.view">
        <field name="name">hotel.profit.report.search</field>
        <field name="model">hotel.profit.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="hotel_id"/>
                <filter name="revenue" string="Revenue"
                        domain="[('line_type', '!=', 'expense')]"/>
                <filter name="expenses" string="Expenses"
                        domain="[('line_type', '=', 'expense')]"/>
                <separator/>
                <filter name="this_year" string="This Year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group>
                    <filter name="group_hotel" string="Hotel" context="{'group_by': 'hotel_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'line_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_profit_report" model="ir.actions.act_window">
        <field name="name">Profitability</field>
        <field name="res_model">hotel.profit.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_year': 1}</field>
    </record>
</odoo>